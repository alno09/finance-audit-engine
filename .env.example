# Application
PORT=3000
APP_PORT=3000
CORS_ORIGIN="http://localhost:3001"

# PostgreSQL credentials used by compose.yml
POSTGRES_DB=finance_audit
POSTGRES_USER=finance
POSTGRES_PASSWORD="change-me-before-deploying"

# Host development connection
DATABASE_URL="postgresql://finance:change-me-before-deploying@localhost:5432/finance_audit"

# Container connection; keep credentials aligned with the values above
CONTAINER_DATABASE_URL="postgresql://finance:change-me-before-deploying@postgres:5432/finance_audit"

# Redis (matches compose.yml)
REDIS_HOST=localhost
REDIS_PORT=6379

# Active AI provider
GEMINI_API_KEY="replace-with-your-gemini-api-key"

# Optional: only needed if AiModule is switched to OpenAiInvoiceProvider
OPENAI_API_KEY="replace-with-your-openai-api-key"
